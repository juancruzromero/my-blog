# =============================================================================
# Django
# =============================================================================

# Clave secreta de Django — generá una nueva con:
# python -c "from django.core.signing import get_cookie_signer; print(get_cookie_signer().key)"
# o: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Hosts permitidos en producción (separados por coma)
# Ejemplo: ALLOWED_HOSTS=midominio.com,www.midominio.com
ALLOWED_HOSTS=

# Activar/desactivar modo debug (usar False en producción)
DEBUG=False


# =============================================================================
# Base de datos (producción — PostgreSQL)
# =============================================================================

DATABASE_URL=postgres://usuario:contraseña@host:5432/nombre_db

# O por separado:
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# =============================================================================
# Email (producción — SMTP)
# =============================================================================

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Dirección que aparece como remitente por defecto
DEFAULT_FROM_EMAIL=


# =============================================================================
# Wagtail
# =============================================================================

# URL base del sitio, sin trailing slash (usado en notificaciones del admin)
WAGTAILADMIN_BASE_URL=https://midominio.com
